[ext_resource type="Texture2D" uid="uid://byn071xu1q5op" path="res://Icons/Remove.svg" id="1_xvgi5"]

[sub_resource type="GDScript" id="GDScript_v5hcl"]
script/source = "extends Button

@onready var popup: Popup = $Popup
@onready var timer: Timer = $Timer

signal confirmed

func _ready() -> void:
	set_process(false)

func _pressed() -> void:
	if popup.visible:
		timer.stop()
		confirmed.emit()
	else:
		popup.position = get_screen_position() + Vector2(size.x + 8, 0)
		popup.size = Vector2(0, size.y)
		popup.popup()
		
		timer.start()

func _on_timer_timeout() -> void:
	popup.hide()
"

