[sub_resource type="GDScript" id="GDScript_hyg6v"]
script/source = "extends Control

@onready var group_name: LineEdit = %GroupName
@onready var routines: HFlowContainer = %Routines

func set_group_name(gr: String):
	if gr.is_empty():
		group_name.text = \"[Default Group]\"
		group_name.editable = false
		%RemoveButton.hide()
	else:
		group_name.text = gr

func color_changed(color: Color) -> void:
	self_modulate = color

func create_routine() -> Control:
	var routine := preload(\"uid://cctfsldanqcig\").instantiate()
	routines.add_child(routine)
	return routine

func _on_group_name_editing_toggled(toggled_on: bool) -> void:
	group_name.flat = not toggled_on
"

