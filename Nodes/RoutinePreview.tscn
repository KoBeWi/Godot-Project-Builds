[sub_resource type="GDScript" id="GDScript_yhlye"]
script/source = "extends ScrollContainer

func _gui_input(event: InputEvent) -> void:
	if not get_v_scroll_bar().visible:
		return
	
	var mb := event as InputEventMouseButton
	if mb:
		if mb.button_index == MOUSE_BUTTON_WHEEL_UP:
			if is_equal_approx(get_v_scroll_bar().value, 0):
				accept_event()
		
		if mb.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			if is_equal_approx(get_v_scroll_bar().value, get_v_scroll_bar().max_value):
				accept_event()
		
"

